/node_modules/
# vendor/ is built per-machine EXCEPT aps-common's src/, which is committed:
# release tarballs carry it as tracked bytes (.nextcloudignore keeps it in).
# Composer's installed extras under vendor/aps (the package's own composer.json,
# tests/, stub/) stay ignored — src/ is the artifact aps-sync reproduces.
/vendor/*
!/vendor/aps/
/vendor/aps/*
!/vendor/aps/common/
/vendor/aps/common/*
!/vendor/aps/common/src/
/.phpunit.cache/
/composer.phar
/tools/
# build — js/'s bundles are built, not committed: the release workflow builds them
# before packing the tarball (pack-app refuses a committed bundle), and a clone needs
# `npm ci && npm run build` before the app works. The .LICENSE.txt files terser
# extracts land in js/ with the bundles — ignored here, regenerated by every build —
# and they carry the third-party licence notices that travel inside the distribution.
# The rules are anchored to js/'s root so js/tts/, the committed voice, never leaves
# git (docs/adr/0005). Sourcemaps are not shipped either.
/js/*.js
/js/*.js.LICENSE.txt
*.js.map
.phpunit.result.cache
/test-results/
/playwright-report/
