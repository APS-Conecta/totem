/node_modules/
# vendor/ is built per-machine EXCEPT aps-common's src/, which is committed:
# release tarballs are `git archive` of the tracked tree, so the shared code
# rides the tarball the way js/ does (farmacia's rule).
/vendor/*
!/vendor/aps/
/vendor/aps/*
!/vendor/aps/common/
/vendor/aps/common/*
!/vendor/aps/common/src/
/.phpunit.cache/
/composer.phar
/tools/
*.js.map
.phpunit.result.cache
/test-results/
/playwright-report/
/.playwright-mcp/
# Local session notes of the remember tool.
/.remember/
